# =========================================================
# WebAgent 环境变量样例
# 使用前复制为 .env 并按需修改；运行时由 pydantic-settings 自动加载
# =========================================================

# ---------------- VL 大模型（OpenAI 兼容协议） ----------------
# 支持任意兼容 OpenAI Chat Completions 协议的多模态模型：
#   - OpenAI GPT-4o:       https://api.openai.com/v1
#   - 通义千问 Qwen-VL:    https://dashscope.aliyuncs.com/compatible-mode/v1
#   - DeepSeek-VL:         https://api.deepseek.com/v1
WEBAGENT_LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WEBAGENT_LLM__API_KEY=sk-your-key-here
WEBAGENT_LLM__MODEL=qwen-vl-max-latest
WEBAGENT_LLM__TEMPERATURE=0.2
WEBAGENT_LLM__TIMEOUT=60

# ---------------- Agent 运行参数 ----------------
WEBAGENT_AGENT__MAX_STEPS=25
WEBAGENT_AGENT__STEP_INTERVAL_MS=600

# ---------------- 浏览器 ----------------
# launch:    每次启动新的 Playwright Chromium
# cdp:       通过 CDP 接管已打开的 Chrome/Edge（推荐）
WEBAGENT_BROWSER__MODE=launch
WEBAGENT_BROWSER__CDP_URL=http://127.0.0.1:9222
WEBAGENT_BROWSER__HEADLESS=false

# ---------------- 日志 ----------------
WEBAGENT_LOG__LEVEL=INFO